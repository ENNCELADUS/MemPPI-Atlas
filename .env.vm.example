# Browser-facing app port on the VM.
APP_PORT=3000

# The Docker image contains the 20260627 graph CSVs and relocated structure assets.
# Keep these paths aligned with Dockerfile and docker-compose.yml.
MEMPPI_DATA_MODE=file
MEMPPI_DATA_ROOT=/app/data/supabase-import/20260627_web_data
STRUCTURE_ASSET_ROOT=/app/data/raw/20260627_web_data/best_structure
